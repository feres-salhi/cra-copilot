# Secrets: never commit keys or passwords
.env
.env.*
!.env.example

# Python cache
__pycache__/

# Virtual environments
venv/
.venv/

# pytest cache
.pytest_cache/

# Private working folders (never upload)
cases/
cache/
runs/

# Key and password files, just in case
*.pem
*.key
*.p12
credentials*.json
secrets.*

# Local Claude Code settings (personal, not for the repo)
.claude/settings.local.json

# Strix raw log and internal state (large, not for upload)
reports/*/strix.log
reports/*/.state/
