        },
        {
          "ruleId": "strix-coverage/symlink-in-cache-folder-redirecting-a-write-or-read-outside-the-folder",
          "ruleIndex": 54,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Symlink in cache folder redirecting a write or read outside the folder — Ruled out: safe_paths.safe_join with pre-existing symlinks in the cache folder\n\nNamed control: safe_join resolves the target and raises 'path leaves its folder' when the resolved parent differs from the base (src/safe_paths.py, target.parent check). Dynamic: a file symlink and a directory symlink named as an OSV cache file were both rejected before any write; the outside directory stayed empty. The symlink precondition requires local write access to the cache folder, which the threat model treats as operator-controlled."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "safe_paths.safe_join with pre-existing symlinks in the cache folder"
                }
              ]
            }
