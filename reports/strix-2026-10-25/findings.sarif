              "recorded_by": "Feed Fetch and Cache Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/unicode-surrogate-purl-reaches-purl-encode-utf-8-and-aborts-the-run",
          "ruleIndex": 62,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Unicode surrogate purl reaches purl.encode('utf-8') and aborts the run — Ruled out: sbom_reader purl to news_watcher purl cache key (lone surrogate and non-ASCII purl)\n\nNamed control: sbom_reader._clean with PURL_PATTERN (ASCII only) rejects a JSON '\\ud800' purl as 'invalid purl' and marks the component UNKNOWN before any feed call (src/sbom_reader.py, PURL_PATTERN and _clean). Dynamic: load_sbom returned the component with status UNKNOWN and reason 'invalid purl'. The UnicodeEncodeError in _purl_cache_path is therefore not reachable from the SBOM."
          },
          "locations": [
