                        "text": "if saved_ids and not saved_ids <= seen:\n        return \"KEV no longer lists entries that were in the saved copy\"\n    if saved_max_count and len(entries) < saved_max_count:\n        return \"KEV count dropped below the highest count seen before\""
                      }
