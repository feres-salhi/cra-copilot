                      "insertedContent": {
                        "text": "problem = validate_kev(\n            data, saved_max or None, saved[\"dateReleased\"] if saved else None,\n            {e[\"cveID\"] for e in saved[\"vulnerabilities\"]} if saved else None,\n        )"
                      }
                    }
