          "level": "note",
          "message": {
            "text": "OSV vulnerability id with a trailing dot aborts the whole run\n\nThe id pattern used for OSV responses accepts an identifier that ends with a dot, but the file-name check used when the id is turned into a cache path rejects it. A feed response that lists such an id raises an uncaught `ValueError` inside `fetch_osv`, which aborts `cra run` for every component. The run is recorded as an internal error and is not completed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/news_watcher.py"
                },
                "region": {
                  "startLine": 56,
                  "endLine": 56
                }
              },
              "message": {
                "text": "Reject a trailing dot in an OSV vulnerability id when the batch answer is parsed"
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "cra run (_parse_batch_result -> fetch_osv -> _vuln_cache_path -> safe_join)",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/news_watcher.py"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 56,
                        "endLine": 56
                      },
                      "insertedContent": {
                        "text": "VULN_ID_PATTERN = re.compile(r\"(?!.*\\.\\.)[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?\")  # no \"..\" anywhere, no trailing dot"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "Make the identifier pattern match exactly what the cache-path check accepts, so that a trailing dot is rejected when the batch answer is parsed. Also catch a rejected identifier at the call site in `fetch_osv` so that a single bad identifier cannot abort the whole run.",
                "markdown": "Make the identifier pattern match exactly what the cache-path check accepts, so that a trailing dot is rejected when the batch answer is parsed. Also catch a rejected identifier at the call site in `fetch_osv` so that a single bad identifier cannot abort the whole run."
              }
