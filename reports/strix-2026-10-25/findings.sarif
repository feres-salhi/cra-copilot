              "risk_area": "evidence file forces exploited=True or suppresses it, or a missing or broken file is treated as known not-exploited",
              "surface": "matcher.exploited_status / read_evidence / invalid_evidence_cves (evidence override direction, missing, stale, future-dated files)",
              "recorded_by": "Matcher Logic Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/unchecked-exploitation-status-reported-as-known-not-exploited-for-components-that-cannot-be-looked-up",
          "ruleIndex": 36,
          "kind": "open",
          "level": "none",
