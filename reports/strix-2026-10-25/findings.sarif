            {
              "id": "strix-coverage/ci-supply-chain-hygiene-developer-tooling",
              "name": "CI supply-chain hygiene (developer tooling)",
              "shortDescription": {
                "text": "Coverage: CI supply-chain hygiene (developer tooling)"
              },
              "fullDescription": {
                "text": "Coverage of CI supply-chain hygiene (developer tooling) across the assessed attack surface."
